# ZenFii ↔ MikroTik Bridge Configuration Template
# Copy this to .env and fill in your real credentials
# NEVER commit .env to GitHub!

# ZenFii Configuration (your reseller/customer account)
ZENFII_URL=https://web.zenfii.net
ZENFII_USERNAME=your_zenfii_username_or_email
ZENFII_PASSWORD=your_zenfii_password

# MikroTik SSH Configuration (VPN access)
MIKROTIK_HOST=vpn4.xenfi.net
MIKROTIK_PORT=33548
MIKROTIK_USERNAME=admin
MIKROTIK_PASSWORD=your_mikrotik_password

# Bridge Configuration
POLL_INTERVAL=120                 # Check ZenFii every 120 seconds
HOTSPOT_PROFILE=default           # MikroTik hotspot profile name
VOUCHER_PASSWORD=voucher          # Password for new hotspot users

# Server
PORT=3000                         # Web server port (for monitoring)
